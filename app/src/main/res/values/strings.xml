    <!-- Recorder -->
    <string name="recorder_instructions">Press and hold to vibrate, release for a pause. How long you hold sets the length; how high up you press sets the strength.</string>
    <string name="recorder_pad_idle">Press and hold here</string>

    <!-- Reliability -->
    <string name="reliability_banner_hint">Tap to see what needs fixing.</string>
    <string name="check_exact_alarms">Exact alarms</string>
    <string name="check_exact_alarms_description">Without this the alarm may be delayed or skipped entirely.</string>
    <string name="check_notifications">Notifications</string>
    <string name="check_notifications_description">Needed for the ringing, snoozed and missed notices. The vibration itself still works without it.</string>
    <string name="check_full_screen">Full-screen alarm</string>
    <string name="check_full_screen_description">Lets the alarm screen appear over the lock screen with its Dismiss and Snooze buttons.</string>
    <string name="check_battery">Battery optimization exemption</string>
    <string name="check_battery_description">Stops the system from deferring the alarm while the phone sleeps.</string>
    <string name="check_amplitude">Vibration strength control</string>
    <string name="check_amplitude_description">Whether the hardware can vary strength. If not, intensity is emulated with short pulses.</string>
    <string name="check_system_vibration">System vibration strength</string>
    <string name="check_system_vibration_description">The app already asks for the strongest vibration the hardware can produce — 255 is the ceiling, not a setting here. Android then scales it by the system\'s own vibration strength, so if that is not at maximum even the strongest pattern arrives weakened. Raise "Vibration intensity" for alarms in the system sound settings.</string>
    <string name="check_oem">Samsung background limits</string>
    <string name="check_oem_description">In Device care → Battery, keep this app out of "Sleeping apps" and turn off "Put unused apps to sleep". Being put to sleep cancels every scheduled alarm, and no app can detect it.</string>
    <string name="reliability_no_settings_page">This device has no settings page for that; open it manually from system settings.</string>
    <string name="reliability_log_title">Event log</string>
    <string name="reboot_test_title">Reboot test</string>
    <string name="reboot_test_description">Schedules a test alarm a few minutes out. Restart the phone and do NOT unlock it — if it vibrates on the lock screen, alarms survive a night-time restart.</string>
    <string name="reboot_test_start">Schedule test</string>
    <string name="reboot_test_scheduled">Test alarm set for %1$s. Restart now and leave the phone locked.</string>
    <string name="reboot_test_waiting">Waiting for the restart and the test alarm…</string>
    <string name="reboot_test_passed">Passed: the alarm fired after a restart before unlocking.</string>
    <string name="reboot_test_failed">The phone restarted but the test alarm did not fire. Check the items above.</string>

    <!-- Settings -->
    <string name="setting_volume_keys_snooze">Volume keys snooze</string>
    <string name="setting_volume_keys_snooze_hint">Works while the alarm screen is showing. With the screen off, Android does not let apps see the volume keys.</string>
    <string name="settings_advanced">Advanced</string>
    <string name="setting_force_pwm">Emulate vibration strength</string>
    <string name="setting_force_pwm_hint">Diagnostic: forces the pulse-based fallback used on phones that cannot vary vibration strength.</string>
    <string name="settings_about_body">A vibration-only alarm clock. A vibration-only alarm plays its pattern once, stops on its own, then snoozes and finally turns itself off — without the phone being touched.</string>

