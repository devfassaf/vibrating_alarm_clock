    <!-- Reliability -->
    <string name="reliability_banner_hint">הקישו כדי לראות מה צריך לתקן.</string>
    <string name="check_exact_alarms">אזעקות מדויקות</string>
    <string name="check_exact_alarms_description">בלי זה ההשכמה עלולה להתעכב או לא לפעול בכלל.</string>
    <string name="check_notifications">התראות</string>
    <string name="check_notifications_description">נדרשות להודעות הצלצול, הנודניק וההחמצה. הרטט עצמו פועל גם בלעדיהן.</string>
    <string name="check_full_screen">מסך השכמה מלא</string>
    <string name="check_full_screen_description">מאפשר למסך ההשכמה להופיע מעל מסך הנעילה עם כפתורי הכיבוי והנודניק.</string>
    <string name="check_battery">פטור מאופטימיזציית סוללה</string>
    <string name="check_battery_description">מונע מהמערכת לדחות את ההשכמה בזמן שהטלפון ישן.</string>
    <string name="check_amplitude">שליטה בעוצמת רטט</string>
    <string name="check_amplitude_description">האם החומרה יכולה לשנות עוצמה. אם לא, העוצמה מדומה בעזרת פולסים קצרים.</string>
    <string name="check_oem">הגבלות רקע של סמסונג</string>
    <string name="check_oem_description">בטיפול במכשיר → סוללה, ודאו שהאפליקציה לא ברשימת "אפליקציות ישנות" ושהאפשרות "העברת אפליקציות שאינן בשימוש למצב שינה" כבויה. העברה למצב שינה מבטלת כל השכמה מתוזמנת, ואף אפליקציה לא יכולה לזהות זאת.</string>
    <string name="reliability_no_settings_page">במכשיר הזה אין מסך הגדרות לכך; פתחו אותו ידנית מהגדרות המערכת.</string>
    <string name="reliability_log_title">יומן אירועים</string>
    <string name="reboot_test_title">בדיקת ריסט</string>
    <string name="reboot_test_description">מתזמן השכמת בדיקה בעוד כמה דקות. הפעילו מחדש את הטלפון ואל תפתחו את הנעילה — אם הוא רוטט על מסך הנעילה, ההשכמות שורדות ריסט בלילה.</string>
    <string name="reboot_test_start">תזמון בדיקה</string>
    <string name="reboot_test_scheduled">השכמת בדיקה נקבעה ל-%1$s. הפעילו מחדש עכשיו והשאירו את הטלפון נעול.</string>
    <string name="reboot_test_waiting">ממתין לריסט ולהשכמת הבדיקה…</string>
    <string name="reboot_test_passed">עבר: ההשכמה פעלה אחרי ריסט, לפני פתיחת הנעילה.</string>
    <string name="reboot_test_failed">הטלפון הופעל מחדש אבל השכמת הבדיקה לא פעלה. בדקו את הסעיפים שלמעלה.</string>

